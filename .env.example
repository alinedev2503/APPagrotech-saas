# Configurações Globais do Produto (Boilerplate / SaaS)
VITE_BAAS_PROVIDER=firebase # Valores válidos: 'firebase' ou 'supabase'

# ==========================================
# FIREBASE CREDENCIAIS
# Preencha se VITE_BAAS_PROVIDER for firebase
# ==========================================
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# ==========================================
# SUPABASE CREDENCIAIS
# Preencha se VITE_BAAS_PROVIDER for supabase
# ==========================================
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# ==========================================
# OUTROS SERVIÇOS (IA, Analytics, etc)
# ==========================================
GEMINI_API_KEY=""
